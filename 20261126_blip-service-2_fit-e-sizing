<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service 2.0 | Critérios, Fit e sizing</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: APENAS Instrument Sans e Figtree -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Sans:wght@500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        display: ['"Instrument Sans"', 'sans-serif'],
                        sans: ['"Figtree"', 'sans-serif'],
                    },
                    colors: {
                        blip: {
                            blue: '#0080ff',
                            navy: '#00295b',
                            offwhite: '#f7f5f0',
                            lime: '#def74f',
                            lilac: '#b08dff',
                            emerald: '#6ccb95'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #f7f5f0;
            color: #00295b;
            font-family: 'Figtree', sans-serif;
            -webkit-font-smoothing: antialiased;
        }
        h1, h2, h3, h4, .font-display {
            font-family: 'Instrument Sans', sans-serif;
        }
        .glass-nav {
            background: rgba(0, 41, 91, 0.96);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        }
        .blip-card {
            background: #ffffff;
            border: 1px solid rgba(0, 41, 91, 0.1);
            box-shadow: 0 4px 20px -4px rgba(0, 41, 91, 0.05);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .blip-card:hover {
            box-shadow: 0 10px 28px -6px rgba(0, 41, 91, 0.09);
        }
        .quadrant-cell {
            transition: all 0.2s ease;
        }
        .quadrant-cell:hover {
            transform: translateY(-2px);
        }
        textarea, input[type="text"] {
            font-family: 'Figtree', sans-serif;
        }
    </style>
</head>
<body class="selection:bg-blip-blue selection:text-white">

    <!-- Barra de navegação superior fixa (escura para destacar logo branca) -->
    <header class="glass-nav fixed top-0 left-0 right-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">
            <div class="flex items-center space-x-3">
                <a href="#" class="flex items-center shrink-0">
                    <img src="https://www.blip.ai/wp-content/uploads/2026/06/logo-blip.png" alt="Logo Blip" class="h-7 sm:h-8 w-auto object-contain" onerror="this.onerror=null;this.src='https://placehold.co/110x32/00295b/ffffff?text=Blip';">
                </a>
                <span class="text-white/25">|</span>
                <div>
                    <span class="font-display font-bold text-white tracking-tight text-sm sm:text-base">Service 2.0</span>
                    <span class="hidden md:inline-block text-white/25 mx-2">·</span>
                    <span class="hidden md:inline-block text-xs font-semibold text-white/75">Critérios, Fit e sizing</span>
                </div>
            </div>

            <!-- Links de navegação rápida -->
            <nav class="hidden xl:flex items-center space-x-1 bg-white/10 p-1 rounded-xl border border-white/15">
                <a href="#sec-premissas" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white/85 hover:text-white hover:bg-white/10 transition">1. Premissas</a>
                <a href="#sec-quadrante" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white/85 hover:text-white hover:bg-white/10 transition">2. Quadrante e dedicação</a>
                <a href="#sec-roteiro" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white/85 hover:text-white hover:bg-white/10 transition">3. Conversa guiada</a>
                <a href="#sec-checklist" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white/85 hover:text-white hover:bg-white/10 transition">4. Checklist</a>
            </nav>

            <!-- Botões de ação da sessão -->
            <div class="flex items-center space-x-2">
                <button onclick="clearAllFields()" class="px-3 py-2 rounded-xl text-xs font-semibold text-white/75 hover:text-white hover:bg-white/10 border border-transparent hover:border-white/15 transition cursor-pointer">
                    Limpar campos
                </button>
                <button onclick="copySessionSummary()" class="inline-flex items-center px-4 py-2 rounded-xl text-xs font-bold text-white bg-blip-blue hover:bg-blip-blue/90 shadow-xs transition active:scale-95 cursor-pointer">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
                    </svg>
                    Copiar resumo completo da sessão
                </button>
            </div>
        </div>
    </header>

    <!-- Notificação toast -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="bg-blip-navy text-white px-4 py-3 rounded-xl shadow-lg flex items-center space-x-2.5 text-sm font-medium border border-white/10">
            <span class="w-2.5 h-2.5 rounded-full bg-blip-lime"></span>
            <span id="toast-message">Resumo copiado para a área de transferência!</span>
        </div>
    </div>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20 space-y-14">

        <!-- =====================================================================
             HEADER EXECUTIVO E BARRA DE CONTEXTO DA SESSÃO
        ====================================================================== -->
        <section class="rounded-3xl bg-blip-navy text-white p-7 sm:p-11 shadow-md relative overflow-hidden">
            <!-- Detalhe geométrico sutil -->
            <div class="absolute -right-12 -top-12 w-72 h-72 rounded-full bg-blip-blue/20 blur-3xl pointer-events-none"></div>

            <div class="relative z-10 max-w-3xl">
                <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-white/10 text-white text-xs font-semibold mb-4">
                    <span class="w-2 h-2 rounded-full bg-blip-emerald"></span>
                    <span>Frente 3 · Critérios e fit de cliente</span>
                    <span>•</span>
                    <span>Salvamento automático ativo</span>
                </div>

                <h1 class="font-display text-3xl sm:text-5xl font-bold tracking-tight leading-tight">
                    Service 2.0 <span class="text-blip-lime">| Fit e sizing</span>
                </h1>
                <p class="text-base sm:text-lg text-white/80 mt-3 leading-relaxed">
                    Board de cocriação: consolidando os aprendizados dos pilotos para calibrar elegibilidade, dedicação das tríades e sizing comercial de novos contratos.
                </p>
            </div>

            <!-- Barra de identificação da pessoa entrevistada -->
            <div class="relative z-10 mt-8 pt-6 border-t border-white/15 grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
                <div class="md:col-span-5">
                    <label for="session-person" class="block text-xs font-bold text-white/75 mb-1.5">Pessoa entrevistada e papel</label>
                    <input id="session-person" data-save="session-person" type="text" placeholder="Ex: Fulano (BS Bradesco), Ciclana (Tech Lead)..." class="w-full rounded-xl bg-white/10 border border-white/20 px-3.5 py-2.5 text-sm text-white placeholder-white/45 focus:bg-white/15 focus:border-blip-lime focus:outline-none transition">
                </div>
                <div class="md:col-span-4">
                    <label for="session-account" class="block text-xs font-bold text-white/75 mb-1.5">Conta ou contexto de referência</label>
                    <input id="session-account" data-save="session-account" type="text" placeholder="Ex: Bradesco, Yduqs, funil Hunt Q4..." class="w-full rounded-xl bg-white/10 border border-white/20 px-3.5 py-2.5 text-sm text-white placeholder-white/45 focus:bg-white/15 focus:border-blip-lime focus:outline-none transition">
                </div>
                <div class="md:col-span-3 flex items-center md:justify-end pb-2">
                    <span id="save-indicator" class="text-xs text-blip-emerald font-medium flex items-center">
                        ✓ Anotações salvas no navegador
                    </span>
                </div>
            </div>
        </section>

        <!-- =====================================================================
             SEÇÃO 1: O QUE JÁ SABEMOS (PREMISSAS DOS PILOTOS) + ANOTAÇÕES
        ====================================================================== -->
        <section id="sec-premissas" class="scroll-mt-24 space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
                <div>
                    <span class="text-xs font-bold text-blip-blue">Seção 01 · base consolidada</span>
                    <h2 class="font-display text-2xl sm:text-3xl font-bold text-blip-navy tracking-tight mt-1">O que já sabemos dos pilotos</h2>
                </div>
                <p class="text-sm text-blip-navy/70">Evidências extraídas das contas-piloto e lições aprendidas</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Coluna green flags -->
                <div class="blip-card rounded-2xl p-6 sm:p-7 border-t-4 border-t-blip-emerald">
                    <div class="flex items-center justify-between mb-5">
                        <div class="flex items-center space-x-3">
                            <span class="w-10 h-10 rounded-xl bg-blip-emerald/20 text-blip-navy flex items-center justify-center font-bold">✓</span>
                            <div>
                                <h3 class="font-display text-lg font-bold text-blip-navy">Green flags · fit validado</h3>
                                <p class="text-xs text-blip-navy/60">Fatores que geraram parceria e ROI</p>
                            </div>
                        </div>
                        <span class="px-3 py-1 rounded-full bg-blip-emerald/20 text-blip-navy text-xs font-bold">Bradesco · Yduqs</span>
                    </div>

                    <ul class="space-y-3 text-sm">
                        <li class="p-3.5 rounded-xl bg-blip-offwhite/70 border border-blip-navy/5">
                            <p class="font-bold text-blip-navy">1. Foco em resultado e evolução (não R$/hora)</p>
                            <p class="text-xs text-blip-navy/75 mt-1">Valor fixo mensal orientado a KPIs de negócio, fugindo da venda de esforço ou "cara-crachá".</p>
                        </li>
                        <li class="p-3.5 rounded-xl bg-blip-offwhite/70 border border-blip-navy/5">
                            <p class="font-bold text-blip-navy">2. Sponsor com abertura consultiva e autonomia</p>
                            <p class="text-xs text-blip-navy/75 mt-1">Liderança no cliente que compra a visão de produto e confia nas recomendações da tríade (BS, EC e Arquiteto de Soluções).</p>
                        </li>
                        <li class="p-3.5 rounded-xl bg-blip-offwhite/70 border border-blip-navy/5">
                            <p class="font-bold text-blip-navy">3. Sinergia da tríade e esteiras sem microgestão</p>
                            <p class="text-xs text-blip-navy/75 mt-1">Autonomia técnica direta eliminou ruídos operacionais e acelerou ciclos de entrega.</p>
                        </li>
                        <li class="p-3.5 rounded-xl bg-blip-offwhite/70 border border-blip-navy/5">
                            <p class="font-bold text-blip-navy">4. Prontidão para dados e AI Tools</p>
                            <p class="text-xs text-blip-navy/75 mt-1">Uso fluido de Design, Insight e Test Agents para comprimir entregas de semanas para dias.</p>
                        </li>
                    </ul>
                </div>

                <!-- Coluna red flags e sinais de alerta -->
                <div class="blip-card rounded-2xl p-6 sm:p-7 border-t-4 border-t-blip-lilac">
                    <div class="flex items-center justify-between mb-5">
                        <div class="flex items-center space-x-3">
                            <span class="w-10 h-10 rounded-xl bg-blip-lilac/25 text-blip-navy flex items-center justify-center font-bold">!</span>
                            <div>
                                <h3 class="font-display text-lg font-bold text-blip-navy">Red flags e sinais de alerta</h3>
                                <p class="text-xs text-blip-navy/60">Gargalos, rollbacks e pontos de atenção</p>
                            </div>
                        </div>
                        <span class="px-3 py-1 rounded-full bg-blip-lilac/25 text-blip-navy text-xs font-bold">MP · Smart Fit</span>
                    </div>

                    <ul class="space-y-3 text-sm">
                        <li class="p-3.5 rounded-xl bg-blip-offwhite/70 border border-blip-navy/5">
                            <p class="font-bold text-blip-navy">1. Redução de horas e sub-dedicação</p>
                            <p class="text-xs text-blip-navy/75 mt-1">Clientes que reduzem o escopo ou as horas contratadas antes mesmo de consolidar a operação levantam a dúvida se o modelo para em pé com baixa dedicação.</p>
                        </li>
                        <li class="p-3.5 rounded-xl bg-blip-offwhite/70 border border-blip-navy/5">
                            <p class="font-bold text-blip-navy">2. Desalinhamento cultural ou escopo "fábrica"</p>
                            <p class="text-xs text-blip-navy/75 mt-1">Mercado Pago e Smart Fit exigiram rollback ágil por incompatibilidade de cultura e expectativa de escopo.</p>
                        </li>
                        <li class="p-3.5 rounded-xl bg-blip-offwhite/70 border border-blip-navy/5">
                            <p class="font-bold text-blip-navy">3. Troca de liderança e apego a cronograma legado</p>
                            <p class="text-xs text-blip-navy/75 mt-1">Mudança de stakeholders trouxe cobrança por cronogramas rígidos e sobrecarga de gestão na tríade (sem PM dedicado).</p>
                        </li>
                        <li class="p-3.5 rounded-xl bg-blip-offwhite/70 border border-blip-navy/5">
                            <p class="font-bold text-blip-navy">4. Bloqueio no acesso a dados</p>
                            <p class="text-xs text-blip-navy/75 mt-1">Ambientes onde o cliente bloqueia consultas ou impõe restrições críticas de acesso limitam a autonomia estratégica do BS.</p>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Espaço de anotações da seção 1 -->
            <div class="blip-card rounded-2xl p-5 sm:p-6 bg-white">
                <label for="notes-sec1" class="flex flex-col sm:flex-row sm:items-center justify-between text-xs font-bold text-blip-navy mb-2 gap-1">
                    <span>📝 Anotações e validação das premissas (seção 1)</span>
                    <span class="text-blip-blue font-semibold">O que a pessoa entrevistada confirma, contesta ou acrescenta aqui?</span>
                </label>
                <textarea id="notes-sec1" data-save="notes-sec1" rows="3" placeholder="Registre reações sobre os aprendizados dos pilotos, nuances de operação ou novas premissas..." class="w-full rounded-xl border border-blip-navy/15 bg-blip-offwhite/50 p-3.5 text-sm text-blip-navy placeholder-blip-navy/40 focus:bg-white focus:border-blip-blue focus:ring-2 focus:ring-blip-blue/15 focus:outline-none transition"></textarea>
            </div>
        </section>

        <!-- =====================================================================
             SEÇÃO 2: MATRIZ DE FIT, SIZING E DEDICAÇÃO (QUADRANTE + HIPÓTESES)
        ====================================================================== -->
        <section id="sec-quadrante" class="scroll-mt-24 space-y-6">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div>
                    <span class="text-xs font-bold text-blip-blue">Seção 02 · modelo de dimensionamento</span>
                    <h2 class="font-display text-2xl sm:text-3xl font-bold text-blip-navy tracking-tight mt-1">Matriz de Fit e sizing e dedicação</h2>
                </div>
                <!-- Filtro de destaque no quadrante -->
                <div class="flex flex-wrap items-center gap-1.5 bg-white px-3 py-2 rounded-xl border border-blip-navy/10">
                    <span class="text-xs font-semibold text-blip-navy/60 mr-1">Focar quadrante:</span>
                    <button onclick="highlightQuadrant('all')" class="quad-btn px-2.5 py-1 rounded-lg text-xs font-bold bg-blip-navy text-white transition cursor-pointer" data-target="all">Todos</button>
                    <button onclick="highlightQuadrant('q1')" class="quad-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-blip-navy/70 hover:bg-blip-offwhite transition cursor-pointer" data-target="q1">Q1 · dedicado</button>
                    <button onclick="highlightQuadrant('q2')" class="quad-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-blip-navy/70 hover:bg-blip-offwhite transition cursor-pointer" data-target="q2">Q2 · compartilhado</button>
                    <button onclick="highlightQuadrant('q3')" class="quad-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-blip-navy/70 hover:bg-blip-offwhite transition cursor-pointer" data-target="q3">Q3 · discovery</button>
                    <button onclick="highlightQuadrant('q4')" class="quad-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-blip-navy/70 hover:bg-blip-offwhite transition cursor-pointer" data-target="q4">Q4 · no-go</button>
                </div>
            </div>

            <!-- Quadrante 2x2 rebalanceado -->
            <div class="blip-card rounded-3xl p-6 sm:p-9 bg-white">
                <div class="relative flex flex-col lg:flex-row items-stretch gap-6">
                    
                    <!-- Eixo Y -->
                    <div class="lg:w-12 flex lg:flex-col items-center justify-between py-2 text-center border-b lg:border-b-0 lg:border-r border-blip-navy/10 pb-3 lg:pb-0 lg:pr-3">
                        <span class="text-[11px] font-bold text-blip-blue">Alto escopo</span>
                        <div class="lg:-rotate-90 whitespace-nowrap my-2 lg:my-0">
                            <span class="font-display text-xs font-bold tracking-wide text-blip-navy">Eixo Y: escopo estratégico e complexidade</span>
                        </div>
                        <span class="text-[11px] font-bold text-blip-navy/45">Escopo enxuto</span>
                    </div>

                    <!-- Grid 2x2 -->
                    <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-5">
                        
                        <!-- Q3: Superior esquerdo (baixa maturidade + alto escopo) -->
                        <div id="card-q3" class="quadrant-cell rounded-2xl p-6 bg-blip-offwhite border border-blip-navy/15 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between gap-2 mb-3">
                                    <span class="px-2.5 py-1 rounded-md bg-blip-lilac text-blip-navy text-[11px] font-bold">Q3 · risco de sobrecarga</span>
                                    <span class="text-xs font-bold text-blip-navy/70">Requer discovery</span>
                                </div>
                                <h3 class="font-display text-lg font-bold text-blip-navy mb-2">Alta demanda sem governança ágil</h3>
                                <p class="text-sm text-blip-navy/80 leading-relaxed mb-4">
                                    Muitas frentes, integrações ou dados travados, mas cliente ainda opera por cronograma rígido. Alto risco da tríade virar gestora de tarefas.
                                </p>
                            </div>
                            <div class="pt-3 border-t border-blip-navy/10 flex items-center justify-between text-xs">
                                <span class="font-semibold text-blip-navy/70">Ação recomendada:</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white text-blip-navy font-bold border border-blip-navy/15">Discovery pago antes do S2.0</span>
                            </div>
                        </div>

                        <!-- Q1: Superior direito (alta maturidade + alto escopo) -->
                        <div id="card-q1" class="quadrant-cell rounded-2xl p-6 bg-blip-navy text-white border border-blip-navy flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between gap-2 mb-3">
                                    <span class="px-2.5 py-1 rounded-md bg-blip-lime text-blip-navy text-[11px] font-bold">Q1 · enterprise dedicado</span>
                                    <span class="text-xs font-bold text-blip-lime">Sizing G · alta dedicação</span>
                                </div>
                                <h3 class="font-display text-lg font-bold text-white mb-2">Tríade dedicada e esteira robusta</h3>
                                <p class="text-sm text-white/85 leading-relaxed mb-4">
                                    Sponsor maduro, visão de produto e alto volume de evolução contínua. Justifica dedicação exclusiva (ou quase integral) de BS, EC e Arquiteto de Soluções com forte apoio da esteira.
                                </p>
                            </div>
                            <div class="pt-3 border-t border-white/15 flex items-center justify-between text-xs">
                                <span class="font-semibold text-white/75">Alocação tríade:</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white/10 text-blip-lime font-bold">1 conta por tríade (full)</span>
                            </div>
                        </div>

                        <!-- Q4: Inferior esquerdo (baixa maturidade + escopo enxuto) -->
                        <div id="card-q4" class="quadrant-cell rounded-2xl p-6 bg-blip-offwhite/60 border border-blip-navy/10 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between gap-2 mb-3">
                                    <span class="px-2.5 py-1 rounded-md bg-blip-navy/10 text-blip-navy text-[11px] font-bold">Q4 · no-go Service 2.0</span>
                                    <span class="text-xs font-bold text-blip-navy/60">Anti-fit</span>
                                </div>
                                <h3 class="font-display text-lg font-bold text-blip-navy mb-2">Escopo fechado ou sub-dedicado</h3>
                                <p class="text-sm text-blip-navy/75 leading-relaxed mb-4">
                                    Contratos com redução drástica de horas, foco em sustentação pontual ou compra estrita por hora/homem. Não sustenta a estrutura consultiva da tríade.
                                </p>
                            </div>
                            <div class="pt-3 border-t border-blip-navy/10 flex items-center justify-between text-xs">
                                <span class="font-semibold text-blip-navy/70">Direcionamento:</span>
                                <span class="px-2.5 py-1 rounded-lg bg-white text-blip-navy font-bold border border-blip-navy/15">Squad tradicional ou sustentação</span>
                            </div>
                        </div>

                        <!-- Q2: Inferior direito (alta maturidade + escopo enxuto) -->
                        <div id="card-q2" class="quadrant-cell rounded-2xl p-6 bg-blip-blue/5 border-2 border-blip-blue flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between gap-2 mb-3">
                                    <span class="px-2.5 py-1 rounded-md bg-blip-blue text-white text-[11px] font-bold">Q2 · sweet spot compartilhado</span>
                                    <span class="text-xs font-bold text-blip-blue">Sizing P / M</span>
                                </div>
                                <h3 class="font-display text-lg font-bold text-blip-navy mb-2">Tríade compartilhada (multicliente)</h3>
                                <p class="text-sm text-blip-navy/85 leading-relaxed mb-4">
                                    Cliente maduro com escopo focado e dados acessíveis. Permite que BS, EC e Arquiteto de Soluções atendam mais contas simultâneas (quantidade a definir) com alta alavancagem de AI Tools.
