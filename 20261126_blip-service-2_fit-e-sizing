    </main>

    <!-- Footer oficial -->
    <footer class="border-t border-blip-navy/10 bg-white py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-xs text-blip-navy/60 gap-2">
            <span class="font-semibold text-blip-navy">Blip Professional Services · evolução Service 2.0</span>
            <span>Board de cocriação · critérios, Fit e sizing</span>
        </div>
    </footer>

    <!-- JavaScript puro: persistência local, filtros, checklist dinâmico e exportação -->
    <script>
        const STORAGE_PREFIX = 'blip_s2_fit_sizing_v3_';
        let customCriterionCounter = 8;

        // 1. Auto-save no localStorage para todos os campos [data-save]
        function initAutoSave() {
            const fields = document.querySelectorAll('[data-save]');
            fields.forEach(field => {
                const key = STORAGE_PREFIX + field.dataset.save;
                const savedVal = localStorage.getItem(key);
                if (savedVal !== null) {
                    field.value = savedVal;
                }
                field.addEventListener('input', () => {
                    localStorage.setItem(key, field.value);
                    const indicator = document.getElementById('save-indicator');
                    if (indicator) {
                        indicator.textContent = 'Salvando...';
                        clearTimeout(window._saveTimer);
                        window._saveTimer = setTimeout(() => {
                            indicator.textContent = '✓ Anotações salvas no navegador';
                        }, 400);
                    }
                });
            });
        }

        // 2. Destaque visual dos quadrantes (seção 2)
        function highlightQuadrant(target) {
            const quads = ['q1', 'q2', 'q3', 'q4'];
            const buttons = document.querySelectorAll('.quad-btn');

            buttons.forEach(btn => {
                if (btn.dataset.target === target) {
                    btn.classList.remove('text-blip-navy/70', 'hover:bg-blip-offwhite');
                    btn.classList.add('bg-blip-navy', 'text-white');
                } else {
                    btn.classList.remove('bg-blip-navy', 'text-white');
                    btn.classList.add('text-blip-navy/70', 'hover:bg-blip-offwhite');
                }
            });

            quads.forEach(q => {
                const el = document.getElementById('card-' + q);
                if (!el) return;
                if (target === 'all' || target === q) {
                    el.style.opacity = '1';
                    el.style.filter = 'none';
                } else {
                    el.style.opacity = '0.32';
                    el.style.filter = 'grayscale(35%)';
                }
            });
        }

        // 3. Filtro de perfis na conversa guiada (seção 3)
        function filterRole(role) {
            const roles = ['triade', 'esteira', 'comercial'];
            const buttons = document.querySelectorAll('.role-btn');

            buttons.forEach(btn => {
                if (btn.dataset.role === role) {
                    btn.classList.remove('text-blip-navy/75', 'hover:bg-blip-offwhite');
                    btn.classList.add('bg-blip-blue', 'text-white');
                } else {
                    btn.classList.remove('bg-blip-blue', 'text-white');
                    btn.classList.add('text-blip-navy/75', 'hover:bg-blip-offwhite');
                }
            });

            roles.forEach(r => {
                const panel = document.getElementById('role-' + r);
                if (!panel) return;
                if (role === 'all' || role === r) {
                    panel.style.display = 'block';
                } else {
                    panel.style.display = 'none';
                }
            });
        }

        // 4. Atualização dos contadores do checklist (seção 4)
        function updateChecklistCounts() {
            const rows = document.querySelectorAll('#checklist-body tr');
            let mandatory = 0, sizing = 0, discard = 0;

            rows.forEach(row => {
                const selected = row.querySelector('input[type="radio"]:checked');
                if (selected) {
                    if (selected.value.startsWith('Obrigatório')) mandatory++;
                    else if (selected.value.startsWith('Calibra')) sizing++;
                    else discard++;
                }
            });

            document.getElementById('count-mandatory').textContent = mandatory;
            document.getElementById('count-sizing').textContent = sizing;
            document.getElementById('count-discard').textContent = discard;
        }

        // 5. Adicionar novo critério ao vivo no checklist
        function addCustomCriterion() {
            const input = document.getElementById('new-criterion-input');
            const text = input.value.trim();
            if (!text) {
                showToast('Digite a descrição do critério antes de incluir.');
                return;
            }

            customCriterionCounter++;
            const idx = customCriterionCounter;
            const tbody = document.getElementById('checklist-body');
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-blip-offwhite/60 transition bg-blip-blue/5';
            tr.dataset.criterion = text;

            tr.innerHTML = `
                <td class="py-4 px-6">
                    <p class="font-bold text-blip-navy">${idx}. ${escapeHtml(text)}</p>
                    <p class="text-xs text-blip-blue mt-0.5">Critério adicionado ao vivo na sessão</p>
                </td>
                <td class="py-4 px-4 hidden md:table-cell">
                    <span class="px-2.5 py-1 rounded-md bg-blip-blue/15 text-blip-blue text-xs font-bold">Novo</span>
                </td>
                <td class="py-4 px-4 text-center">
                    <input type="radio" name="crit-${idx}" value="Obrigatório (go/no-go)" checked class="w-4 h-4 accent-blip-blue cursor-pointer">
                </td>
                <td class="py-4 px-4 text-center">
                    <input type="radio" name="crit-${idx}" value="Calibra sizing (P/M/G)" class="w-4 h-4 accent-blip-blue cursor-pointer">
                </td>
                <td class="py-4 px-4 text-center">
                    <input type="radio" name="crit-${idx}" value="Descartar" class="w-4 h-4 accent-blip-blue cursor-pointer">
                </td>
            `;

            tbody.appendChild(tr);
            tr.querySelectorAll('input[type="radio"]').forEach(r => r.addEventListener('change', updateChecklistCounts));
            input.value = '';
            updateChecklistCounts();
            showToast('Novo critério adicionado ao checklist!');
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        // 6. Limpar todos os campos de anotação
        function clearAllFields() {
            const fields = document.querySelectorAll('[data-save]');
            fields.forEach(f => {
                f.value = '';
                localStorage.removeItem(STORAGE_PREFIX + f.dataset.save);
            });
            showToast('Todas as anotações foram limpas!');
        }

        // 7. Toast de feedback
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            clearTimeout(window._toastTimer);
            window._toastTimer = setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3200);
        }

        // 8. Exportar resumo completo formatado
        function copySessionSummary() {
            const val = id => (document.getElementById(id)?.value.trim() || '(sem anotações)');

            const rows = document.querySelectorAll('#checklist-body tr');
            let checklistLines = [];
            rows.forEach((row, i) => {
                const title = row.dataset.criterion;
                const selected = row.querySelector('input[type="radio"]:checked');
                const classification = selected ? selected.value : 'não classificado';
                checklistLines.push(`${i + 1}. ${title} -> [${classification}]`);
            });

            const summary = `# Service 2.0 | resumo de cocriação: Fit e sizing
- **Pessoa entrevistada e papel:** ${val('session-person')}
- **Conta ou contexto:** ${val('session-account')}
- **Data:** ${new Date().toLocaleDateString('pt-BR')}

---
## 1. Premissas dos pilotos
${val('notes-sec1')}

---
## 2. Matriz de Fit e sizing e dedicação
- **Hipótese A (multicliente vs. dedicação tríade):** ${val('hyp-dedication')}
- **Hipótese B (piso mínimo de contrato):** ${val('hyp-floor')}
- **Hipótese C (apoio da esteira e peso de dados):** ${val('hyp-track')}
- **Anotações gerais do quadrante:** ${val('notes-sec2')}

---
## 3. Conversa guiada por perfil
### Tríades (BS, EC e Arquiteto de Soluções)
- **1. Divisão de dedicação (contas simultâneas):** ${val('q-triade-1')}
- **2. Sinais de rollback e redução de escopo:** ${val('q-triade-2')}
- **3. Postura do cliente vs. microgestão:** ${val('q-triade-3')}
- **4. Dependência de dados, esteira e ferramentas de IA:** ${val('q-triade-4')}

### Lideranças da esteira
- **1. Gatilhos de sizing (P -> M -> G):** ${val('q-esteira-1')}
- **2. Escopo oculto:** ${val('q-esteira-2')}
- **3. Alavancagem de AI Tools:** ${val('q-esteira-3')}

### Para Service Design
- **1. Gatilhos de entrada:** ${val('q-comercial-1')}
- **2. Objeções e precificação:** ${val('q-comercial-2')}
- **3. Informações disponíveis na venda:** ${val('q-comercial-3')}

### Síntese geral da conversa
${val('notes-sec3')}

---
## 4. Calibração do checklist de elegibilidade
${checklistLines.join('\n')}

### Anotações finais e próximos passos
${val('notes-sec4')}
`;

            const tempArea = document.createElement('textarea');
            tempArea.value = summary;
            tempArea.style.position = 'fixed';
            tempArea.style.left = '-9999px';
            document.body.appendChild(tempArea);
            tempArea.select();

            try {
                document.execCommand('copy');
                showToast('Resumo completo copiado em Markdown!');
            } catch (err) {
                showToast('Erro ao copiar resumo.');
            }
            document.body.removeChild(tempArea);
        }

        // Inicialização
        document.addEventListener('DOMContentLoaded', () => {
            initAutoSave();
            document.querySelectorAll('#checklist-body input[type="radio"]').forEach(r => {
                r.addEventListener('change', updateChecklistCounts);
            });
            updateChecklistCounts();

            // Permitir Enter no campo de adicionar critério
            document.getElementById('new-criterion-input').addEventListener('keypress', e => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    addCustomCriterion();
                }
            });
        });
    </script>
